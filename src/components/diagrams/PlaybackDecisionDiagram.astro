---
	import ArchDiagram from './ArchDiagram.astro';
	import type { Node, Edge } from '@xyflow/svelte';

	const nodes: Node[] = [
		{ id: 'client', type: 'flow', position: { x: 250, y: 0 }, data: { title: 'Client', sub: 'detects codec / HDR support per delivery path', kind: 'viewer', hasSource: true } },
		{ id: 'planner', type: 'flow', position: { x: 245, y: 160 }, data: { title: 'Server planner', sub: 'sole authority · picks delivery path + method', kind: 'app', hasTarget: true, hasSource: true } },
		{ id: 'direct', type: 'flow', position: { x: -30, y: 340 }, data: { title: 'Direct play', sub: 'stream the file as-is', kind: 'source', hasTarget: true, hasSource: true } },
		{ id: 'remux', type: 'flow', position: { x: 250, y: 340 }, data: { title: 'Remux', sub: 'copy streams into HLS · no re-encode', kind: 'default', hasTarget: true, hasSource: true } },
		{ id: 'transcode', type: 'flow', position: { x: 530, y: 340 }, data: { title: 'Transcode', sub: 're-encode video and/or audio · FFmpeg', kind: 'proxy', hasTarget: true, hasSource: true } },
		{ id: 'player', type: 'flow', position: { x: 250, y: 520 }, data: { title: 'Playback', sub: 'native video · hls.js · Safari HLS', kind: 'viewer', hasTarget: true } },
	];

	const edges: Edge[] = [
		{ id: 'e-cl-pl', source: 'client', target: 'planner', label: 'capabilities' },
		{ id: 'e-pl-direct', source: 'planner', target: 'direct', label: 'fully compatible' },
		{ id: 'e-pl-remux', source: 'planner', target: 'remux', label: 'container / audio mismatch' },
		{ id: 'e-pl-tr', source: 'planner', target: 'transcode', label: 'unsupported · HDR · burn-in', animated: true },
		{ id: 'e-direct-p', source: 'direct', target: 'player' },
		{ id: 'e-remux-p', source: 'remux', target: 'player' },
		{ id: 'e-tr-p', source: 'transcode', target: 'player' },
	];
---

<ArchDiagram nodes={nodes} edges={edges} title="Playback delivery choices" />
