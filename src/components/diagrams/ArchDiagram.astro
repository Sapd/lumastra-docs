---
import type { Node, Edge } from '@xyflow/svelte';
import layouts from './layouts.json';
interface Props { nodes: Node[]; edges: Edge[]; title: string }
const { nodes, edges, title } = Astro.props;
const graph = layouts[title as keyof typeof layouts];
if (!graph || graph.nodes.length !== nodes.length || graph.edges.length !== edges.length) throw new Error(`Regenerate diagram layouts: ${title}`);
const marker = `arrow-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<figure class="connected-diagram not-content">
	<figcaption>{title}</figcaption>
	<div class="diagram-toolbar">
		<label class="fit-control"><input type="checkbox" /> Fit diagram to width</label>
		<button class="fullscreen-control" type="button" hidden>Fullscreen</button>
	</div>
	<p class="hint">Scroll, swipe, or click and drag to explore. Use the arrows to move, or fit the diagram above.</p>
	<div class="pan-controls" aria-label={`${title}: diagram navigation`} hidden>
		<button type="button" data-dx="-1" data-dy="0" aria-label="Scroll diagram left">←</button>
		<button type="button" data-dx="1" data-dy="0" aria-label="Scroll diagram right">→</button>
		<button type="button" data-dx="0" data-dy="-1" aria-label="Scroll diagram up">↑</button>
		<button type="button" data-dx="0" data-dy="1" aria-label="Scroll diagram down">↓</button>
	</div>
	<div class="diagram-scroll" tabindex="0" role="region" aria-label={`${title}: scrollable diagram`}>
		<svg width={graph.width} height={graph.height} viewBox={`0 0 ${graph.width} ${graph.height}`} role="img" aria-label={title}>
			<title>{title}</title>
			<defs><marker id={marker} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#c4a5ff" /></marker></defs>
			{graph.edges.map(edge => <g data-edge-id={edge.id}>
				<path class="edge" d={edge.path} marker-end={`url(#${marker})`} />
			</g>)}
			{graph.nodes.map(node => <g class={`node ${node.kind}`} data-node-id={node.id} transform={`translate(${node.x},${node.y})`}>
				<rect width={node.width} height={node.height} rx="10" />
				<text class="node-title" x="14" y="28">{node.title.map((line, i) => <tspan x="14" dy={i ? 20 : 0}>{line}</tspan>)}</text>
				<text class="node-sub" x="14" y={28 + node.title.length * 20 + 3}>{node.sub.map((line, i) => <tspan x="14" dy={i ? 17 : 0}>{line}</tspan>)}</text>
			</g>)}
			{graph.edges.flatMap(edge => (edge.labels ?? []).map(label => <g class="edge-label" transform={`translate(${label.x},${label.y})`}>
				<rect width={label.width} height={label.height} rx="4" />
				<text x="8" y="19">{label.text!.split('\n').map((line, i) => <tspan x="8" dy={i ? 18 : 0}>{line}</tspan>)}</text>
			</g>))}
		</svg>
	</div>
</figure>
<script>
	for (const figure of document.querySelectorAll<HTMLElement>('.connected-diagram')) {
		const viewport = figure.querySelector<HTMLElement>('.diagram-scroll')!;
		const controls = figure.querySelector<HTMLElement>('.pan-controls')!;
		const buttons = controls.querySelectorAll<HTMLButtonElement>('button');
		const fullscreen = figure.querySelector<HTMLButtonElement>('.fullscreen-control')!;
		if (document.fullscreenEnabled) {
			fullscreen.hidden = false;
			fullscreen.addEventListener('click', async () => {
				try {
					if (document.fullscreenElement === figure) await document.exitFullscreen();
					else await figure.requestFullscreen();
				} catch {
					// Browser policies may decline fullscreen; keep scrolling available.
				}
			});
			document.addEventListener('fullscreenchange', () => {
				fullscreen.textContent = document.fullscreenElement === figure ? 'Exit fullscreen' : 'Fullscreen';
			});
		}
		const update = () => {
			const maxX = viewport.scrollWidth - viewport.clientWidth;
			const maxY = viewport.scrollHeight - viewport.clientHeight;
			controls.hidden = maxX < 2 && maxY < 2;
			viewport.classList.toggle('can-pan', !controls.hidden);
			for (const button of buttons) {
				const dx = Number(button.dataset.dx);
				const dy = Number(button.dataset.dy);
				button.disabled = dx < 0 ? viewport.scrollLeft < 1 : dx > 0 ? viewport.scrollLeft >= maxX - 1
					: dy < 0 ? viewport.scrollTop < 1 : viewport.scrollTop >= maxY - 1;
			}
		};
		for (const button of buttons) button.addEventListener('click', () => {
			viewport.scrollBy({ left: Number(button.dataset.dx) * viewport.clientWidth * 0.7,
				top: Number(button.dataset.dy) * viewport.clientHeight * 0.7 });
		});
		let drag: { id: number; x: number; y: number; left: number; top: number } | undefined;
		viewport.addEventListener('pointerdown', (event) => {
			if (event.pointerType !== 'mouse' || event.button !== 0 || controls.hidden) return;
			drag = { id: event.pointerId, x: event.clientX, y: event.clientY,
				left: viewport.scrollLeft, top: viewport.scrollTop };
			viewport.setPointerCapture(event.pointerId);
			viewport.classList.add('dragging');
			viewport.focus({ preventScroll: true });
			event.preventDefault();
		});
		viewport.addEventListener('pointermove', (event) => {
			if (!drag || event.pointerId !== drag.id) return;
			viewport.scrollLeft = drag.left - (event.clientX - drag.x);
			viewport.scrollTop = drag.top - (event.clientY - drag.y);
		});
		const stopDrag = () => { drag = undefined; viewport.classList.remove('dragging'); };
		viewport.addEventListener('pointerup', (event) => {
			if (drag?.id === event.pointerId) viewport.releasePointerCapture(event.pointerId);
			stopDrag();
		});
		viewport.addEventListener('pointercancel', stopDrag);
		viewport.addEventListener('lostpointercapture', stopDrag);
		viewport.addEventListener('scroll', update, { passive: true });
		figure.querySelector('input')!.addEventListener('change', () => requestAnimationFrame(update));
		const observer = new ResizeObserver(update);
		observer.observe(viewport);
		observer.observe(viewport.querySelector('svg')!);
		update();
	}
</script>
<style>
	.connected-diagram { margin: 1.5rem 0; padding: 1rem; border: 1px solid #69518e; border-radius: 16px; background: #100b1c; color: #f5f0ff; }
	figcaption { margin-bottom: 0.6rem; font-size: 1.05rem; font-weight: 700; }
	.fit-control { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; cursor: pointer; }
	.diagram-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; }
	.fullscreen-control { border: 1px solid #8c70b5; border-radius: 6px; padding: 0.4rem 0.75rem; background: #2a1b42; color: #f5f0ff; cursor: pointer; font: inherit; font-size: 0.85rem; }
	.fullscreen-control[hidden] { display: none; }
	.fullscreen-control:focus-visible { outline: 2px solid #c4a5ff; outline-offset: 2px; }
	.connected-diagram:fullscreen { display: flex; flex-direction: column; width: 100%; height: 100%; max-width: none; margin: 0; border: 0; border-radius: 0; box-sizing: border-box; }
	.connected-diagram:fullscreen .diagram-scroll { flex: 1; min-height: 0; max-height: none; }
	input { accent-color: #a78bfa; }
	.hint { margin: 0.35rem 0 1rem; font-size: 0.8rem; color: #c9bddf; }
	.pan-controls { display: flex; gap: 0.4rem; margin-bottom: 0.6rem; }
	.pan-controls[hidden] { display: none; }
	.pan-controls button { width: 2.5rem; height: 2.5rem; border: 1px solid #8c70b5; border-radius: 6px; background: #2a1b42; color: #f5f0ff; font-size: 1.1rem; cursor: pointer; }
	.pan-controls button:disabled { opacity: 0.35; cursor: default; }
	.pan-controls button:focus-visible { outline: 2px solid #c4a5ff; outline-offset: 2px; }
	.diagram-scroll { overflow: auto; max-height: min(70vh, 640px); scrollbar-color: #a78bfa #1c142a; }
	.diagram-scroll.can-pan { cursor: grab; }
	.diagram-scroll.dragging { cursor: grabbing; user-select: none; }
	.diagram-scroll:focus-visible { outline: 2px solid #c4a5ff; outline-offset: 2px; }
	svg { display: block; max-width: none; margin-inline: auto; }
	.connected-diagram:has(input:checked) svg { width: 100%; height: auto; }
	svg text { font-family: 'JetBrains Mono Variable', monospace; }
	.edge { fill: none; stroke: #c4a5ff; stroke-width: 2; stroke-linejoin: round; }
	.node rect { fill: #1c142a; stroke: #8c70b5; stroke-width: 1.5; }
	.node.app rect, .node.proxy rect { fill: #2a1b42; stroke: #a78bfa; }
	.node.source rect { stroke: #5eead4; }
	.node.infra rect { stroke-dasharray: 5 3; }
	.node-title { fill: #f5f0ff; font-size: 14px; font-weight: 700; }
	.node-sub { fill: #c9bddf; font-size: 12px; }
	.edge-label rect { fill: #100b1c; }
	.edge-label text { fill: #f5f0ff; font-size: 13px; }
</style>
