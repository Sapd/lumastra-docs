---
	import ArchDiagram from './ArchDiagram.astro';
	import type { Node, Edge } from '@xyflow/svelte';

	const nodes: Node[] = [
		{
			id: 'src',
			type: 'flow',
			position: { x: 250, y: 0 },
			data: { title: 'Your tuner / approved feed', sub: 'HDHomeRun · M3U · Xtream', kind: 'source', hasSource: true },
		},
		{
			id: 'import',
			type: 'flow',
			position: { x: 240, y: 140 },
			data: {
				title: 'Import & auto-process',
				sub: 'channels · EPG · backup groups · quality tiers',
				kind: 'default',
				hasTarget: true,
				hasSource: true,
			},
		},
		{
			id: 'app',
			type: 'flow',
			position: { x: 235, y: 290 },
			data: {
				title: 'Lumastra app',
				sub: 'resolve channel · ordered URLs (primary + backups) · access policy',
				kind: 'app',
				hasTarget: true,
				hasSource: true,
			},
		},
		{
			id: 'proxy',
			type: 'flow',
			position: { x: 235, y: 450 },
			data: {
				title: 'Stream Proxy',
				sub: 'one upstream per channel (multiplex) · FFmpeg · SSRF check',
				kind: 'proxy',
				hasTarget: true,
				hasSource: true,
			},
		},
		{
			id: 'upstream',
			type: 'flow',
			position: { x: 5, y: 620 },
			data: { title: 'Permitted live feed', sub: 'configured upstream · permitted backups', kind: 'ext', hasTarget: true },
		},
		{
			id: 'viewers',
			type: 'flow',
			position: { x: 237, y: 620 },
			data: { title: 'Permitted viewers', sub: 'HLS · shared upstream connection', kind: 'viewer', hasTarget: true },
		},
	];

	const edges: Edge[] = [
		{ id: 'e-src-import', source: 'src', target: 'import' },
		{ id: 'e-import-app', source: 'import', target: 'app' },
		{ id: 'e-app-proxy', source: 'app', target: 'proxy', label: 'hand off · secret' },
		{ id: 'e-proxy-up', source: 'proxy', target: 'upstream', label: 'pull · failover', animated: true },
		{ id: 'e-proxy-view', source: 'proxy', target: 'viewers', label: 'HLS', animated: true },
	];
---

<ArchDiagram nodes={nodes} edges={edges} title="Live TV processing and delivery" />
