---
	import ArchDiagram from './ArchDiagram.astro';
	import type { Node, Edge } from '@xyflow/svelte';

	const nodes: Node[] = [
		{ id: 'phone', type: 'flow', position: { x: 0, y: 0 }, data: { title: 'Phone / Web', sub: 'heartbeat every 2-3 min', kind: 'viewer', hasSource: true } },
		{ id: 'server', type: 'flow', position: { x: 232, y: 0 }, data: { title: 'Server', sub: 'presence cache, 10 min TTL', kind: 'app', hasTarget: true, hasSource: true } },
		{ id: 'action', type: 'flow', position: { x: 0, y: 170 }, data: { title: 'Pending action', sub: 'stored, 5 min TTL', kind: 'infra', hasTarget: true, hasSource: true } },
		{ id: 'tvos', type: 'flow', position: { x: 232, y: 170 }, data: { title: 'tvOS', sub: 'polls every ~5 s', kind: 'viewer', hasTarget: true, hasSource: true } },
	];

	const edges: Edge[] = [
		{ id: 'e-phone-server', source: 'phone', target: 'server', label: 'online status' },
		{ id: 'e-select', source: 'phone', target: 'action', label: 'POST /devices/{id}/actions' },
		{ id: 'e-action-tvos', source: 'action', target: 'tvos', label: 'GET /devices/{id}/actions' },
		{ id: 'e-tvos-action', source: 'tvos', target: 'action', label: 'PATCH accepted → session data' },
	];
---

<ArchDiagram nodes={nodes} edges={edges} title="Send to Device" />
